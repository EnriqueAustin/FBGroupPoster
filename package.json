{
  "name": "fb-group-poster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assisted (later automated) drip poster for Facebook groups across multiple businesses.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "bootstrap": "tsx src/cli/bootstrap-groups.ts",
    "plan": "tsx src/cli/plan.ts",
    "run": "tsx src/cli/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "backup": "tsx src/cli/backup.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^11.8.0",
    "fastify": "^5.2.0",
    "playwright": "^1.50.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
